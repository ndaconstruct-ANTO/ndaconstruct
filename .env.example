# =============================================================================
# Exemple de fichier d'environnement
# =============================================================================
# Copiez ce fichier en ".env" et renseignez vos clés UNIQUEMENT quand vous
# déciderez d'activer un fournisseur d'images réel.
#
#     cp .env.example .env
#
# Tant que vous restez en mode simulation (par défaut), aucune clé n'est requise
# et aucune dépense n'est possible.
# =============================================================================

# --- OpenAI (gpt-image-1) ---
OPENAI_API_KEY=

# --- Stable Diffusion (API auto-hébergée ou tierce) ---
SD_API_URL=
SD_API_KEY=

# --- Flux ---
FLUX_API_KEY=

# --- ComfyUI (serveur local ou distant) ---
COMFYUI_API_URL=
