# Copiez ce fichier en ".env" et renseignez vos clés pour la génération RÉELLE.
# Le mode simulation (par défaut) NE nécessite AUCUNE clé.

# Clé API OpenAI (uniquement pour --real --provider openai)
OPENAI_API_KEY=

# Modèle d'image OpenAI (par défaut: gpt-image-1, repli automatique: dall-e-3)
OPENAI_IMAGE_MODEL=gpt-image-1
